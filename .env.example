# Copy to .env.local (git-ignored). Never commit real values.
# Without the Supabase variables the storefront still browses the demo catalog, but accounts,
# orders and checkout are unavailable.

# ── Supabase: PUBLIC (safe in the browser; Row Level Security limits what they can do) ─────────
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (formerly "anon"). NEVER put a service-role / secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase: SERVER ONLY (no NEXT_PUBLIC_ prefix, never sent to the browser) ──────────────────
# Postgres connection used by route handlers to create orders, reserve stock and verify payments.
# Use the Session pooler string (Dashboard > Connect), which works over IPv4:
#   postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ -> %40, # -> %23, ] -> %5D ...).
SUPABASE_DB_URL=

# ── Site ───────────────────────────────────────────────────────────────────────────────────────
# Public origin, used to build payment return URLs. Defaults to the request origin when unset.
NEXT_PUBLIC_SITE_URL=

# ── Payments (online only, no Cash on Delivery) ────────────────────────────────────────────────
# Leave PAYMENT_PROVIDER empty until a gateway adapter is implemented and its credentials exist:
# checkout then reports "payment is not set up" and creates no orders.
PAYMENT_PROVIDER=
# Minutes stock is held for an unpaid order (5 to 1440). A retry refreshes the hold.
INVENTORY_RESERVATION_MINUTES=30
# Local testing ONLY: PAYMENT_PROVIDER=sandbox enables a fake gateway that moves no money. It is refused
# outright when NODE_ENV=production. Generate a secret with: openssl rand -hex 32
PAYMENT_SANDBOX_WEBHOOK_SECRET=
# Real gateway secrets go here once chosen (examples; server-only, never NEXT_PUBLIC_):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional HTTP cron fallback for GET /api/cron/expire-reservations (pg_cron already does this in the DB).
CRON_SECRET=

# ── Support ────────────────────────────────────────────────────────────────────────────────────
# WhatsApp click-to-chat: digits with country code, no "+" (e.g. 919876543210).
# Until set, the UI shows "WhatsApp support coming soon" instead of a link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional support email shown on the Help page.
NEXT_PUBLIC_SUPPORT_EMAIL=
