# Copy to .env.local. The app runs in demo mode without any of these.

# Supabase (public values only). Never put a service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp click-to-chat: digits with country code, no "+" (e.g. 919876543210).
# Until set, the UI shows "WhatsApp support coming soon" instead of a link.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional support email shown on the Help page.
NEXT_PUBLIC_SUPPORT_EMAIL=
